---
interface Props {
	current: number;
	total: number;
	/** 生成第 n 页的地址 */
	href: (n: number) => string;
}
const { current, total, href } = Astro.props;

// 始终显示首尾页，当前页前后各一页，其余折叠为省略号
const pages: (number | "…")[] = [];
for (let i = 1; i <= total; i++) {
	if (i === 1 || i === total || Math.abs(i - current) <= 1) pages.push(i);
	else if (pages[pages.length - 1] !== "…") pages.push("…");
}
---
{total > 1 && (
	<nav class="pager" aria-label="分页">
		{current > 1 ? <a href={href(current - 1)} rel="prev" aria-label="上一页">‹</a> : <span class="dis">‹</span>}
		{pages.map((p) =>
			p === "…" ? <span class="dis">…</span> : p === current ? <span aria-current="page">{p}</span> : <a href={href(p)}>{p}</a>,
		)}
		{current < total ? <a href={href(current + 1)} rel="next" aria-label="下一页">›</a> : <span class="dis">›</span>}
	</nav>
)}
