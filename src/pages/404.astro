---
import Glass from "@/components/Glass.astro";
import Base from "@/layouts/Base.astro";
---
<Base title="页面不存在" noindex iePath="/ie/">
	<Glass quiet class="card e404 reveal" variant="reading">
		<h1>404</h1>
		<p>没找到这个页面。</p>
		<p><a class="btn btn--primary" href="/">回到首页</a> <button class="btn" type="button" data-open-search>搜索文章</button></p>
	</Glass>
</Base>
