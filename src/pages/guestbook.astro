---
import { getEntry, render } from "astro:content";
import Glass from "@/components/Glass.astro";
import { giscus } from "@/config";
import Base from "@/layouts/Base.astro";

const entry = await getEntry("spec", "guestbook");
if (!entry) throw new Error("src/content/spec/guestbook.md 不存在");
const { Content } = await render(entry);
---
<Base title="留言板" description="在这里留下你的足迹。">
	<div class="layout layout--wide">
		<Glass quiet class="card article__body reveal" variant="reading">
			<div class="page-head">
				<h1>留言板</h1>
			</div>
			<div class="prose"><Content /></div>
		</Glass>
		<Glass
			quiet
			id="comments"
			class="card comments"
			data-repo={giscus.repo}
			data-repo-id={giscus.repoId}
			data-category={giscus.category}
			data-category-id={giscus.categoryId}
			data-mapping={giscus.mapping}
			data-lang={giscus.lang}
		>
			<h3 class="card__title">留言</h3>
			<p class="comments__ph">留言区加载中（基于 GitHub Discussions，需要 GitHub 账号）</p>
		</Glass>
	</div>
</Base>
