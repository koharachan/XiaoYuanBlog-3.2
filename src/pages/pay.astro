---
import Icon from "@/components/Icon.astro";
import Base from "@/layouts/Base.astro";
import { sponsor } from "@/config";
---
<Base title={sponsor.title} description={sponsor.description}>
	<div class="layout layout--wide">
		<section class="card article__body reveal">
			<div class="page-head">
				<h1><Icon name="heart" class="inline" size={28} /> {sponsor.title}</h1>
				<p>{sponsor.description}</p>
			</div>
			<div class="pay-grid">
				{sponsor.methods.map((m, i) => (
					<div class="card reveal" style={`--i:${i}`}>
						{m.qr && <img src={m.qr} alt={`${m.name} 收款码`} width="300" height="300" loading="lazy" decoding="async" />}
						<h3>{m.name}</h3>
						{m.wallet && <code>{m.wallet}</code>}
						<small>{m.note}</small>
						{m.link && <a class="btn" href={m.link} target="_blank" rel="noopener"><Icon name="external" />打开</a>}
					</div>
				))}
			</div>
			{sponsor.sponsors.length > 0 && (
				<>
					<h2 class="card__title" style="margin-top:2rem">感谢名单</h2>
					<ul class="sponsors">
						{sponsor.sponsors.map((s) => (
							<li><span>{s.name}{s.message && <small style="color:var(--muted)"> · {s.message}</small>}</span><b>{s.amount} <small style="color:var(--muted);font-weight:400">{s.date}</small></b></li>
						))}
					</ul>
				</>
			)}
		</section>
	</div>
</Base>
