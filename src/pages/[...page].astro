---
import type { GetStaticPaths } from "astro";
import Pagination from "@/components/Pagination.astro";
import PostCard from "@/components/PostCard.astro";
import Sidebar from "@/components/Sidebar.astro";
import { site } from "@/config";
import Base from "@/layouts/Base.astro";
import { getPosts, getTags } from "@/lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPosts();
	return paginate(posts, { pageSize: site.postsPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const [posts, tags] = await Promise.all([getPosts(), getTags()]);
const days = Math.floor((Date.now() - new Date(site.startDate).getTime()) / 86400000);
const isFirst = page.currentPage === 1;
---
<Base title={isFirst ? undefined : `第 ${page.currentPage} 页`} iePath={isFirst ? "/ie/" : `/ie/${page.currentPage}/`}>
	{isFirst && (
		<section class="card intro">
			<h1>{site.title}</h1>
			<p class="intro__tag">{site.tagline}</p>
			<p>{site.description}</p>
			<ul class="intro__stats">
				<li><b>{posts.length}</b>篇文章</li>
				<li><b>{tags.length}</b>个标签</li>
				<li>开站 <b>{days}</b> 天</li>
			</ul>
		</section>
	)}
	<div class="layout">
		<section class="posts" aria-label="文章列表">
			{page.data.map((post, i) => (<PostCard post={post} index={i} eager={i < 2} />))}
			<Pagination current={page.currentPage} total={page.lastPage} href={(n) => (n === 1 ? "/" : `/${n}/`)} />
		</section>
		<aside class="side">
			<Sidebar />
		</aside>
	</div>
</Base>
