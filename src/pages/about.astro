---
import { getEntry, render } from "astro:content";
import Glass from "@/components/Glass.astro";
import Sidebar from "@/components/Sidebar.astro";
import Base from "@/layouts/Base.astro";

const entry = await getEntry("spec", "about");
if (!entry) throw new Error("src/content/spec/about.md 不存在");
const { Content } = await render(entry);
---
<Base title="关于" description="关于我是一个普通的人，">
	<div class="layout">
		<Glass quiet class="card article__body reveal" variant="reading">
			<div class="prose"><Content /></div>
		</Glass>
		<aside class="side"><Sidebar terms={false} /></aside>
	</div>
</Base>
