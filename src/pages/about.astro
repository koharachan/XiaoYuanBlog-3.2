---
import { getEntry, render } from "astro:content";
import Sidebar from "@/components/Sidebar.astro";
import Base from "@/layouts/Base.astro";

const entry = await getEntry("spec", "about");
if (!entry) throw new Error("src/content/spec/about.md 不存在");
const { Content } = await render(entry);
---
<Base title="关于" description="关于小原酱和这个博客。">
	<div class="layout">
		<article class="card article__body reveal">
			<div class="prose"><Content /></div>
		</article>
		<aside class="side"><Sidebar terms={false} /></aside>
	</div>
</Base>
