---
import { getEntry, render } from "astro:content";
import Glass from "@/components/Glass.astro";
import { friends } from "@/config";
import Base from "@/layouts/Base.astro";

const entry = await getEntry("spec", "friends");
if (!entry) throw new Error("src/content/spec/friends.md 不存在");
const { Content } = await render(entry);
---
<Base title="友链" description="朋友们的站点，以及友链申请方式。">
	<div class="layout layout--wide">
		<Glass quiet class="card article__body reveal" variant="reading">
			<div class="page-head">
				<h1>友情链接</h1>
				<p>排名不分先后。欢迎互换。</p>
			</div>
			<div class="friends">
				{friends.map((f) => (
					<a href={f.url} target="_blank" rel="noopener">
						<Glass class="card card--glow">
							{f.avatar && <img class="friends__avatar" src={f.avatar} alt="" width="44" height="44" />}
							<span class="friends__meta">
								<b>{f.name}</b>
								<small>{f.desc}</small>
							</span>
						</Glass>
					</a>
				))}
			</div>
			<div class="prose"><Content /></div>
		</Glass>
	</div>
</Base>
