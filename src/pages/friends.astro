---
import { getEntry, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import { friends } from "@/config";

const entry = await getEntry("spec", "friends");
if (!entry) throw new Error("src/content/spec/friends.md 不存在");
const { Content } = await render(entry);
---
<Base title="友链" description="朋友们的站点，以及友链申请方式。">
	<div class="layout layout--wide">
		<article class="card article__body reveal">
			<div class="page-head">
				<h1>友情链接</h1>
				<p>排名不分先后。欢迎互换。</p>
			</div>
			<div class="friends">
				{friends.map((f) => (
					<a class="card card--glow" href={f.url} target="_blank" rel="noopener">
						<b>{f.name}</b>
						<small>{f.desc}</small>
					</a>
				))}
			</div>
			<div class="prose"><Content /></div>
		</article>
	</div>
</Base>
